# Music Rights Checker Backend Configuration Example
# Copy to .env for local development. NEVER commit real secrets to Git.

MRC_ENV=development
MRC_DATABASE_URL=sqlite+aiosqlite:///./data/mrc.db
MRC_SYNC_DATABASE_URL=sqlite:///./data/mrc.db

# Security & Abuse Protection
# Generate a strong random token (>= 32 bytes) for reviewer/admin endpoints in production:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MRC_ADMIN_API_KEY=
MRC_RATE_LIMIT_REQUESTS_PER_MINUTE=60
MRC_REPORT_RATE_LIMIT_PER_MINUTE=10
MRC_MAX_CONCURRENT_RESEARCH_JOBS=4

# Cache & Revalidation TTLs (seconds)
MRC_VERIFIED_CACHE_TTL_SECONDS=604800
MRC_UNVERIFIED_CACHE_TTL_SECONDS=86400
MRC_FORCE_REFRESH_COOLDOWN_SECONDS=300

# External Evidence Fetching
MRC_ALLOW_LIVE_HTTP_EVIDENCE=true
MRC_HTTP_FETCH_TIMEOUT_SECONDS=8.0
MRC_MAX_EVIDENCE_BYTES=262144

# AI Research Provider ("none", "openai", "anthropic", "gemini")
# Private provider credentials remain strictly on the backend and are NEVER sent to clients.
MRC_AI_PROVIDER=none
MRC_AI_API_KEY=
MRC_AI_MODEL=
MRC_AI_BASE_URL=
MRC_AI_TIMEOUT_SECONDS=15.0
MRC_DAILY_AI_CALL_BUDGET=250
